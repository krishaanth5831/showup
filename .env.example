# Only needed when the app runs on a server (Vercel). On your own computer none of
# these are required: the database and the secret key are created in ./.data.

# Postgres connection string (for example from Neon, added through the Vercel Marketplace).
DATABASE_URL=

# Long random text. It encrypts the bank and Strava keys in the database and signs the login.
# Make one with:  openssl rand -base64 48
# Changing it later means connecting bunq and Strava again.
APP_SECRET=

# Long random text. Vercel Cron sends it with the nightly check so nobody else can trigger it.
CRON_SECRET=

# Optional. The time zone all deadlines use. Default: Europe/Amsterdam.
# SHOWUP_TZ=Europe/Amsterdam
